# LiveKit Configuration
# Get free account at: https://cloud.livekit.io
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=your_api_key_here
LIVEKIT_API_SECRET=your_api_secret_here

# Database Configuration
# Neon PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME?ssl=require

# CORS Configuration (comma-separated for multiple origins)
# Example: http://localhost:8081,https://your-app.vercel.app
FRONTEND_ORIGIN=http://localhost:8081

# Server Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Groq Configuration (required by the agent, optional for the API)
# Get free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# Text-to-Speech (edge-tts, free, no key needed)
TTS_VOICE=en-IN-NeerjaNeural
TTS_RATE=+8%
